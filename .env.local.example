# Supabase Configuration
# Get these values from your Supabase project settings:
# https://supabase.com/dashboard/project/_/settings/api

# Public keys (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side only (NEVER expose to client)
# Used for admin operations that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Gemini model to use for text generation (optional, defaults to gemini-3-flash-preview)
GEMINI_MODEL=gemini-3-flash-preview

# Gemini model for image generation (optional, defaults to gemini-3-pro-image-preview)
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview

# Feature Flags
# Enable mock data for development (shows placeholder data in Map, Codex, etc.)
# Also enables mock user authentication (requires test user in auth.users table)
# Set to "true" to enable mock data mode
NEXT_PUBLIC_USE_MOCK_DATA=false

# Waitlist mode - when true, new signups get tier='waitlist' and can't play
# Set to "false" to disable waitlist and allow all users to play
NEXT_PUBLIC_WAITLIST_MODE=true
