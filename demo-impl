                "file_text": "-- Demo Seed Data for Spec 3.1: Demo Experience\n-- Windhollow Vale starting area with NPCs, quests, and locations\n\n-- ============================================\n-- LOCATIONS\n-- ============================================\n\n-- Update existing Waypoint location to match new lore\nUPDATE waypoint_locations \nSET \n  region = 'Windhollow Vale',\n  description = 'An ancient waystone rises from the prairie grass, its weathered surface etched with faded runes. The air around it shimmers faintly, carrying whispers of distant places.',\n  type = 'landmark'\nWHERE name = 'The Waypoint';\n\n-- Insert if not exists (for fresh installs)\nINSERT INTO waypoint_locations (name, type, region, description, art_url, is_preseeded)\nVALUES (\n  'The Waystone',\n  'landmark',\n  'Windhollow Vale',\n  'An ancient waystone rises from the prairie grass, its weathered surface etched with faded runes. The air around it shimmers faintly, carrying whispers of distant places.',\n  '/location_waypoint.png',\n  true\n)\nON CONFLICT DO NOTHING;\n\n-- Nomante Outpost\nINSERT INTO waypoint_locations (name, type, region, description, is_preseeded)\nVALUES (\n  'Nomante Outpost',\n  'outpost',\n  'Windhollow Vale',\n  'A sturdy frontier post built from timber and stone. The Nomante family banner flies above the gate - three crossed spears on a field of green. Smoke rises from the forge.',\n  true\n)\nON CONFLICT DO NOTHING;\n\n-- Windhollow Wilderness (for wandering between locations)\nINSERT INTO waypoint_locations (name, type, region, description, is_preseeded)\nVALUES (\n  'Windhollow Wilderness',\n  'wilderness',\n  'Windhollow Vale',\n  'Rolling prairie stretches in every direction, tall grass swaying in the gentle breeze. Wildflowers dot the landscape, and the distant calls of birds fill the air.',\n  true\n)\nON CONFLICT DO NOTHING;\n\n-- ============================================\n-- NPCs\n-- ============================================\n\n-- Lenna - Scholar at the Waystone\nINSERT INTO waypoint_npcs (name, role, location, personality, dialogue_hints, is_preseeded)\nVALUES (\n  'Lenna',\n  'Scholar',\n  'The Waystone',\n  '[\"shy\", \"enthusiastic\", \"curious\", \"kind\", \"slightly awkward\"]',\n  '[\"Researching the waystone for months with no results\", \"Sent by an academy but feels undervalued\", \"Excited by new discoveries\", \"Speaks quickly when passionate\", \"Blushes easily\", \"Has a handmade token she gives to friends\", \"Knows the way to Nomante Outpost\"]',\n  true\n)\nON CONFLICT DO NOTHING;\n\n-- Aran Nomante - Outpost Captain\nINSERT INTO waypoint_npcs (name, role, location, personality, dialogue_hints, is_preseeded)\nVALUES (\n  'Aran Nomante',\n  'Outpost Captain',\n  'Nomante Outpost',\n  '[\"grizzled\", \"practical\", \"honorable\", \"stern but fair\", \"protective\"]',\n  '[\"His family has run this outpost for three generations\", \"Takes duty seriously\", \"Respects those who prove themselves\", \"Provides equipment to travelers in need\", \"Speaks in short direct sentences\", \"Has seen many strange things from the waystone\"]',\n  true\n)\nON CONFLICT DO NOTHING;\n\n-- Adrian - Ranger\nINSERT INTO waypoint_npcs (name, role, location, personality, dialogue_hints, is_preseeded)\nVALUES (\n  'Adrian',\n  'Ranger',\n  'Nomante Outpost',\n  '[\"eager\", \"young\", \"enthusiastic\", \"wants to prove himself\", \"friendly\"]',\n  '[\"Aran''s right hand and protégé\", \"Assigned to the outpost recently\", \"Knows the wilderness well\", \"Hunts boar for the outpost''s food supply\", \"Offers hunting quests\", \"Rewards helpers with his spare hunting bow\"]',\n  true\n)\nON CONFLICT DO NOTHING;\n\n-- Helga - Caravan Trader\nINSERT INTO waypoint_npcs (name, role, location, personality, dialogue_hints, is_preseeded)\nVALUES (\n  'Helga',\n  'Caravan Trader',\n  'Nomante Outpost',\n  '[\"strong\", \"seasoned\", \"practical\", \"warm underneath gruffness\", \"loves blueberries\"]',\n  '[\"Runs a trading caravan that stops at the outpost\", \"Has traveled many roads\", \"Secretly loves blueberry pie\", \"Calls rare berries ''mysterious'' but they''re just blueberries\", \"Rewards helpers with her famous pie\", \"Knows market prices everywhere\"]',\n  true\n)\nON CONFLICT DO NOTHING;\n\n-- The Wanderer - Mysterious roaming figure\nINSERT INTO waypoint_npcs (name, role, location, personality, dialogue_hints, is_preseeded)\nVALUES (\n  'The Wanderer',\n  'Mystery',\n  'Windhollow Wilderness',\n  '[\"enigmatic\", \"cryptic\", \"friendly but distant\", \"all-knowing\", \"vanishes when pressed\"]',\n  '[\"Appears randomly on the prairie\", \"Wears a hooded cloak that obscures their face\", \"Speaks in riddles and hints\", \"Knows things they shouldn''t\", \"Leaves abruptly if questioned too directly\", \"Never gives straight answers\", \"Seems to be watching over travelers\"]',\n  true\n)\nON CONFLICT DO NOTHING;\n\n-- ============================================\n-- QUESTS\n-- ============================================\n\n-- Welcome to Windhollow - Tutorial quest\nINSERT INTO waypoint_quests (title, description, total_progress, leads, is_preseeded)\nVALUES (\n  'Welcome to Windhollow',\n  'Lenna suggested visiting Nomante Outpost to get properly equipped for your journey. Captain Aran Nomante can help.',\n  3,\n  '[\"Travel to Nomante Outpost\", \"Speak with Captain Aran\", \"Receive your equipment\"]',\n  true\n)\nON CONFLICT DO NOTHING;\n\n-- The Boar Hunt - Combat tutorial\nINSERT INTO waypoint_quests (title, description, total_progress, leads, is_preseeded)\nVALUES (\n  'The Boar Hunt',\n  'Adrian needs help hunting a wild boar for the outpost''s food supply. Track it down in the wilderness and bring back the meat.',\n  3,\n  '[\"Search the wilderness for boar tracks\", \"Hunt down the wild boar\", \"Return to Adrian with the meat\"]',\n  true\n)\nON CONFLICT DO NOTHING;\n\n-- Berry Gathering - Exploration quest\nINSERT INTO waypoint_quests (title, description, total_progress, leads, is_preseeded)\nVALUES (\n  'Berry Gathering',\n  'Helga is looking for some \"rare and mysterious berries\" that grow in the prairie. She''ll reward you handsomely for finding them.',\n  3,\n  '[\"Search the prairie for the mysterious berries\", \"Identify the correct berries\", \"Return to Helga with your findings\"]',\n  true\n)\nON CONFLICT DO NOTHING;\n\n-- ============================================\n-- WORLD NEWS\n-- ============================================\n\nINSERT INTO waypoint_world_news (title, text, news_type, status)\nVALUES (\n  'Strange Light at the Waystone',\n  'Travelers report seeing an unusual glow emanating from the ancient waystone in Windhollow Vale. A young scholar named Lenna has been investigating.',\n  'rumor',\n  'rumor'\n)\nON CONFLICT DO NOTHING;\n\nINSERT INTO waypoint_world_news (title, text, news_type, status)\nVALUES (\n  'Peaceful Times in Windhollow',\n  'The Nomante Outpost reports quiet conditions in the vale. Captain Aran notes the wildlife remains calm, though hunters should watch for wild boar.',\n  'news',\n  'canon'\n)\nON CONFLICT DO NOTHING;\n",
